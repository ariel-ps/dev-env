#!/usr/bin/env bash
# Set the kitty pane/tab title from an AI-agent lifecycle hook.
#
# Reads the hook's JSON payload on stdin and renders:
#   "<agent letter> <repo>[/<branch>] <state emoji>"   e.g. "C ps-agent/PROE-7695 ⚙"
#
# Usage (from a hook command):  kitty-agent-title claude
#                               kitty-agent-title codex
#
# Scope: sets the individual kitty *window* (pane) title by default, because a
# splits layout puts several agents in one tab and set-tab-title would make them
# fight over a single string. kitty's default tab_title_template is "{title}",
# so the tab still shows the active pane's title. Override with
#   export KITTY_AGENT_TITLE_SCOPE=tab
# if you run one agent per tab and want the title to stick to the whole tab.
#
# The title is set *permanently* (no --temporary) on purpose. claude/codex both
# emit their own OSC title sequences while they render, and a --temporary title
# yields to the next program-set title, so it would survive for milliseconds.
# The trade-off is that the override outlives the agent, so a flag file is left
# behind for kitty-tab-title.sh to clear it at the next shell prompt.
#
# The OSC escape at the bottom is a fallback for non-kitty terminals only. In a
# hook context /dev/tty is usually "device not configured" (the agent, not this
# script, owns the pty), so it is not a reliable path here.

set -u

# Hooks can inherit a minimal PATH that lacks Homebrew, which is where kitten
# lives on macOS. Without this the kitten @ calls silently fall through to the
# OSC fallback.
case ":$PATH:" in
  *:/opt/homebrew/bin:*) ;;
  *) PATH="/opt/homebrew/bin:$PATH" ;;
esac

AGENT=${1:-agent}
PAYLOAD=$(cat 2>/dev/null || true)

# PreToolUse hooks run synchronously — Claude Code waits for this before the tool
# runs — so every subprocess here is latency added to every single tool call in
# every session. That budget is why the four fields are pulled in ONE jq pass
# instead of one call each, and why the git information below is read from the
# filesystem rather than by running git. Measured: 165ms -> ~30ms.
if [ -n "$PAYLOAD" ]; then
  # Fields are joined on \x1f (unit separator), NOT tab. Tab counts as IFS
  # whitespace, so `read` collapses runs of it into a single delimiter and drops
  # empty fields — an absent transcript_path would then shift `message` into
  # TRANSCRIPT and leave MESSAGE empty, silently mis-reporting every permission
  # notification as a plain one. A non-whitespace IFS preserves empty fields.
  # \x1f also cannot occur in the values, so nothing needs escaping.
  IFS=$'\x1f' read -r EVENT CWD SESSION_ID TRANSCRIPT MESSAGE <<EOF
$(printf '%s' "$PAYLOAD" | jq -j '
  [.hook_event_name, .cwd, .session_id, .transcript_path, .message]
  | map(. // "" | tostring | gsub("[\n\r]"; " ")) | join("")' 2>/dev/null)
EOF
else
  EVENT="" CWD="" SESSION_ID="" TRANSCRIPT="" MESSAGE=""
fi
[ -n "$CWD" ] || CWD=$PWD

# Repo + branch without invoking git: two git subprocesses cost ~98ms of the
# hook's old 165ms, and this reproduces their answer in ~7ms.
#
# Walk up for .git, which lands on a linked worktree's own root the same way
# `rev-parse --show-toplevel` does — a worktree has .git as a FILE, so -e (not
# -d) is what matches both cases. Then read HEAD directly: "ref: refs/heads/x"
# yields x, and a bare sha means detached, which has no branch name to show.
GIT_DIR=$CWD
while [ "$GIT_DIR" != "/" ] && [ -n "$GIT_DIR" ]; do
  [ -e "$GIT_DIR/.git" ] && break
  GIT_DIR=${GIT_DIR%/*}
  [ -n "$GIT_DIR" ] || GIT_DIR=/
done

BRANCH=""
if [ -e "$GIT_DIR/.git" ]; then
  REPO=${GIT_DIR##*/}
  if [ -d "$GIT_DIR/.git" ]; then
    HEAD_FILE="$GIT_DIR/.git/HEAD"
  else
    # Worktree: .git is a file containing "gitdir: <path>", and HEAD lives there.
    HEAD_FILE=$(cut -d' ' -f2- <"$GIT_DIR/.git" 2>/dev/null)/HEAD
  fi
  HEAD_REF=$(cat "$HEAD_FILE" 2>/dev/null || true)
  case "$HEAD_REF" in
    "ref: refs/heads/"*) BRANCH=${HEAD_REF#ref: refs/heads/} ;;
  esac
else
  REPO=${CWD##*/}
fi

# Mainline branches carry no information; prefixed branches are shortened to the
# part that identifies the work.
case "$BRANCH" in
  main | master | trunk | "") BRANCH="" ;;
  feature/* | feat/* | fix/* | bugfix/* | chore/* | hotfix/*) BRANCH=${BRANCH#*/} ;;
esac
# Long ticket-style branches get truncated so the tab bar stays readable.
if [ ${#BRANCH} -gt 24 ]; then
  BRANCH="${BRANCH:0:23}…"
fi

case "$AGENT" in
  claude) WHO="C" ;;
  codex) WHO="X" ;;
  *) WHO="$AGENT" ;;
esac

# CX_NAME is what a launcher already decided this pane is called, and it is the
# name `cx ls` shows. Prefer it over the cwd's basename so the title and the name
# are the same identity — otherwise a grid pane is "home-1" to cx and
# "1 C ariel.zilbershteyin" in the tab bar, which is two names for one pane.
# It already ends in the pane number, so KITTY_AGENT_TITLE_PREFIX is redundant
# here and only applies when no CX_NAME was given.
if [ -n "${CX_NAME:-}" ]; then
  LABEL="$WHO ${CX_NAME}"
else
  LABEL="$WHO $REPO"
  [ -n "${KITTY_AGENT_TITLE_PREFIX:-}" ] && LABEL="${KITTY_AGENT_TITLE_PREFIX} $LABEL"
fi

[ -n "$BRANCH" ] && LABEL="$LABEL/$BRANCH"

# MARK is for the human reading the tab bar; STATE is the same fact in a form
# `cx ls` can consume. Deliberately a small vocabulary — running / waiting / idle
# is what matters when you have nine panes and can look at one.
case "$EVENT" in
  SessionStart) MARK="🌱" STATE="start" ;;
  UserPromptSubmit | PostToolUse) MARK="💭" STATE="running" ;;
  PreToolUse) MARK="⚙" STATE="running" ;;
  PermissionRequest) MARK="❓" STATE="waiting" ;;
  # Notification carries the reason in .message; permission_prompt means the
  # agent is blocked on the user, idle_prompt means it is just sitting there.
  Notification)
    case "$MESSAGE" in
      *ermission* | *pproval* | *licitation*) MARK="❓" STATE="waiting" ;;
      *) MARK="🔔" STATE="notify" ;;
    esac
    ;;
  # SubagentStop means a subagent finished, not the session — the session itself
  # is still working, so it must not be reported idle.
  Stop) MARK="✔" STATE="idle" ;;
  SubagentStop) MARK="✔" STATE="running" ;;
  StopFailure) MARK="✖" STATE="failed" ;;
  SessionEnd) MARK="💤" STATE="ended" ;;
  PreCompact | PostCompact) MARK="🧹" STATE="compacting" ;;
  *) MARK="" STATE="" ;;
esac

TITLE=$LABEL
[ -n "$MARK" ] && TITLE="$TITLE $MARK"

# KITTY_AGENT_TITLE_DEBUG=1 prints the computed title and skips the side effects,
# so the mapping can be checked without a live kitty window.
if [ -n "${KITTY_AGENT_TITLE_DEBUG:-}" ]; then
  printf '%s\n' "$TITLE"
  [ -n "${KITTY_AGENT_TITLE_DEBUG_STATE:-}" ] && printf 'state=%s\n' "$STATE"
  exit 0
fi

# Publish the same facts as a state record for `cx ls` to read. This is why the
# hook exists twice over: scraping "esc to interrupt" off a pane's screen guesses
# at what the hook payload states outright, and costs a kitten @ get-text per
# pane. Keyed by session_id rather than kitty window id because a session running
# under tmux (aoe-grid-*) has no window id to key on — the claude process is a
# child of the tmux server, not of the pane.
if [ -n "$SESSION_ID" ]; then
  case "$SESSION_ID" in
    # A session id lands in a filename, so refuse anything that is not the
    # uuid-shaped token it is supposed to be.
    *[!0-9a-zA-Z-]* | "") ;;
    *)
      CX_DIR="${CX_STATE_DIR:-$HOME/.claude/cx}/state"
      if mkdir -p "$CX_DIR" 2>/dev/null; then
        CX_TMP="$CX_DIR/.$SESSION_ID.$$"
        # Builtins rather than `hostname` and `date` subprocesses. HOSTNAME is set
        # by every bash back to 3.2; EPOCHSECONDS only from 5.0, and the shebang
        # resolves before this script can fix PATH, so macOS's /bin/bash 3.2 is
        # reachable and needs the fallback.
        if jq -n \
          --arg session_id "$SESSION_ID" \
          --arg agent "$AGENT" \
          --arg host "${HOSTNAME%%.*}" \
          --arg win "${KITTY_WINDOW_ID:-}" \
          --arg cwd "$CWD" \
          --arg repo "$REPO" \
          --arg branch "$BRANCH" \
          --arg state "$STATE" \
          --arg event "$EVENT" \
          --arg transcript "$TRANSCRIPT" \
          --arg title "$TITLE" \
          --argjson ts "${EPOCHSECONDS:-$(date +%s)}" \
          '{$session_id, $agent, $host, $cwd, $repo, $branch, $state, $event,
            $transcript, $title, $ts, win: (if $win == "" then null else ($win | tonumber) end)}' \
          >"$CX_TMP" 2>/dev/null; then
          mv -f "$CX_TMP" "$CX_DIR/$SESSION_ID.json" 2>/dev/null || rm -f "$CX_TMP" 2>/dev/null
        else
          rm -f "$CX_TMP" 2>/dev/null
        fi
      fi
      ;;
  esac
fi

SCOPE=${KITTY_AGENT_TITLE_SCOPE:-window}
SET_OK=

if command -v kitten >/dev/null 2>&1; then
  if [ "$SCOPE" = tab ]; then
    kitten @ set-tab-title "$TITLE" >/dev/null 2>&1 ||
      kitten @ --to "${KITTY_LISTEN_ON:-unix:@kitty}" set-tab-title "$TITLE" >/dev/null 2>&1 &&
      SET_OK=1
  else
    kitten @ set-window-title "$TITLE" >/dev/null 2>&1 ||
      kitten @ --to "${KITTY_LISTEN_ON:-unix:@kitty}" set-window-title "$TITLE" >/dev/null 2>&1 &&
      SET_OK=1
  fi
fi

# Breadcrumb so the shell prompt hook knows an override is in place and can clear
# it — without paying for a kitten subprocess on every single prompt.
if [ -n "$SET_OK" ] && [ -n "${KITTY_WINDOW_ID:-}" ]; then
  FLAG_DIR="${TMPDIR:-/tmp}/kitty-agent-title"
  mkdir -p "$FLAG_DIR" 2>/dev/null &&
    : >"$FLAG_DIR/win-${KITTY_WINDOW_ID}.$SCOPE" 2>/dev/null || true
fi

# Fallback for non-kitty terminals: OSC 2 sets the window title, OSC 30 the tab
# title. Skipped when kitten already did the job, since a program-set title would
# just be redundant here.
if [ -z "$SET_OK" ]; then
  (
    exec 2>/dev/null
    printf '\033]2;%s\a' "$TITLE" >/dev/tty || true
    [ "$SCOPE" = tab ] && printf '\033]30;%s\a' "$TITLE" >/dev/tty
    true
  ) || true
fi

exit 0
