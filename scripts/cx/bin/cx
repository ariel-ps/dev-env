#!/bin/sh
# cx — executable twin of the `cx` shell function in ../cx.sh, so the command
# also works where that function isn't available: subshells, non-zsh shells,
# and Claude Code's Bash tool when the shell snapshot didn't replay it.
#
# Absolute interpreter paths deliberately: a Claude Code session has the
# modern-python plugin's shim dir first on PATH, and its `python3` refuses to
# run. cx.py is stdlib-only, so system python is fine.

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for py in /opt/homebrew/bin/python3 /usr/bin/python3; do
  if [ -x "$py" ]; then
    exec "$py" "$here/cx.py" "$@"
  fi
done

py=$(command -v python3 2>/dev/null) || true
[ -n "$py" ] || { echo "cx: no python3 found" >&2; exit 1; }
exec "$py" "$here/cx.py" "$@"
